# clang-tidy configuration.
#
# Correctness and performance checks only. Nothing here is a style opinion:
# modernize-*, readability-*, google-*, llvm-*, hicpp-* and the like are left
# at their default (off), and formatting is clang-format's job with a stock
# style. The bar for a check being here is that a finding is a plausible bug
# or a real cost, not a matter of taste.
#
# Run:  cmake --build --preset core --target tidy   (see cmake/Quality.cmake)
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-throwing-static-initialization,
  clang-analyzer-*,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  concurrency-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-misleading-capture-default-by-value,
  misc-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-no-recursion,
  -misc-unused-parameters,
  performance-*,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once

# Excluded, and why:
#   bugprone-easily-swappable-parameters   a design lint, fires on (int, int)
#   bugprone-throwing-static-initialization   every static here that can
#                                          throw is a standard container,
#                                          which MSVC's allocates for even
#                                          empty, or Catch2's test
#                                          registration; an allocation failure
#                                          while the DLL loads has nothing to
#                                          recover to
#   clang-analyzer-core.FixedAddressDereference   reading a slot of the game's
#                                          own vtable, at its Address Library
#                                          address, is what a hook is; six
#                                          hits, all of that kind
#   clang-analyzer-optin.core.EnumCastOutOfRange   an opt-in check that fires
#                                          inside MSVC's own <filesystem>
#                                          (xfilesystem_abi.h: a stats-flags
#                                          bitmask OR'd to 33) on any status
#                                          query, and inside Catch2 on every
#                                          REQUIRE, where no NOLINT of ours
#                                          reaches; a flags enum combined is
#                                          what a flags enum is for
#   performance-no-int-to-ptr              an address cast is what a hook or
#                                          an offset read of an engine struct
#                                          IS; ten hits, all of that kind
#   performance-enum-size                  "make the enum a byte": nothing here
#                                          has enough of them to matter
#   misc-const-correctness                 style; also very noisy
#   misc-include-cleaner                   include hygiene, not correctness
#   misc-non-private-member-variables-in-classes   style
#   misc-use-anonymous-namespace           style (static vs anonymous namespace)
#   misc-no-recursion                      recursion is fine; the evaluator uses it
#   misc-unused-parameters                 the compiler already warns (C4100)
#   portability-avoid-pragma-once          every header here uses #pragma once,
#                                          and every compiler this builds with
#                                          (MSVC, clang-cl) keeps it

# Our headers anywhere under src. The lint targets pass this checkout's src
# as an absolute path instead (cmake/Quality.cmake), which is stricter; this
# is for clang-tidy run from this file alone, an editor's.
HeaderFilterRegex: 'src[/\\]'
FormatStyle: file

# A finding fails the run. Without this clang-tidy exits 0 on warnings, the
# build's per-file stamp is touched, and the NEXT run reports nothing while
# the findings are still there: a clean-looking pass with work outstanding,
# the same blind spot as the .pch one in CLAUDE.md. (The stamp also depends
# on this file, so a check switched on here re-lints everything.)
WarningsAsErrors: '*'

CheckOptions:
  # int -> float loses nothing below 2^24, and the game's numbers are floats
  # met by our ints on every line of Sensors.cpp. Truncations the other way
  # (float -> int, 64 -> 32 bit) are still reported.
  - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: false
